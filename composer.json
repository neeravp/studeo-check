{
    "name": "studeo/check",
    "description": "Static-analysis engine for Laravel projects.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "nikic/php-parser": "^5.0",
        "symfony/finder": "^7.0 || ^8.0",
        "symfony/console": "^7.4 || ^8.0"
    },
    "bin": [
        "bin/check"
    ],
    "require-dev": {
        "pestphp/pest": "^5.2",
        "laravel/pint": "^1.27",
        "phpstan/phpstan": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "Studeo\\Check\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Studeo\\Check\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
